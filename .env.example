# Copy to .env (git-ignored) next to docker-compose.yml. Never commit real values.

# Required: Postgres password (no default).
POSTGRES_PASSWORD=

# Required: public host name served by Caddy over HTTPS (use localhost for a local stack).
COACH_DOMAIN=localhost

# Optional: host ports published by Caddy (defaults 80 and 443).
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# Optional, dev only (compose.dev.yml): loopback port for Postgres (default 5432).
# POSTGRES_HOST_PORT=5432
